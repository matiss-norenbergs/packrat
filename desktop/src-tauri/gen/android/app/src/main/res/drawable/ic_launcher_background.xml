<?xml version="1.0" encoding="utf-8"?>
<!-- Adaptive icon background: the favicon's purple gradient (frontend/public/favicon.svg), full-bleed
     and square. The launcher applies its own mask (circle, squircle, ...), so no rounded corners here.
     Angle 315 = top-left to bottom-right, as the favicon's x1=0,y1=0 -> x2=48,y2=48 gradient. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <gradient
        android:type="linear"
        android:angle="315"
        android:startColor="#FFA855F7"
        android:endColor="#FF7E14FF" />
</shape>
