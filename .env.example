PORT=50505
DB_PATH=./data/db/packrat.db
MEDIA_ROOT=./data/media
IMAGES_ROOT=./data/images
BACKUPS_ROOT=./data/backups
CACHE_ROOT=./data/cache
MAX_CONCURRENT_DOWNLOADS=2
MAX_CONCURRENT_FFMPEG_TRANSCODES=2
YTDLP_PATH=yt-dlp
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
PIP_PATH=pip
# Origins (comma-separated, no wildcard) allowed to call the API cross-origin - the desktop app.
# Unset = the Tauri defaults (tauri://localhost, http(s)://tauri.localhost).
# CORS_ALLOWED_ORIGINS=
# Reverse proxies (IPs/CIDRs, comma-separated) whose X-Forwarded-For is believed when working out the
# client IP for login rate limiting. Unset = trust none (the connection address is the client).
# TRUSTED_PROXIES=
# Key that encrypts two-factor secrets at rest. Unset = an auto-generated key file
# (packrat-secret.key) next to the database. If you change/lose it, run `packrat --disable-2fa`.
# PACKRAT_SECRET_KEY=
